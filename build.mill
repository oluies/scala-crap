package build

import mill.*
import mill.scalalib.*
import mill.contrib.scoverage.ScoverageModule

object `package` extends ScoverageModule {
  def scalaVersion = "2.13.18"
  def scoverageVersion = "2.5.2"
  def scalacOptions = Seq("-deprecation", "-feature", "-Xlint:unused")
  def mainClass = Some("scalacrap.Main")
  def mvnDeps = Seq(
    mvn"org.scalameta::scalameta:4.17.4",
    mvn"org.scala-lang.modules::scala-xml:2.5.0"
  )

  object test extends ScoverageTests with TestModule.Munit {
    def mvnDeps = Seq(mvn"org.scalameta::munit:1.0.4")
  }
}
